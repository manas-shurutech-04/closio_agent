# closio-agent: our own scripts run without an approval prompt in Codex too (D49, D56).
# Codex "rules" are experimental. They load only when this project's .codex/ folder is trusted.
# An allowed command runs outside Codex's sandbox (it needs the network, Homebrew, Docker, macOS dialogs, the Keychain).
# Check a command with:  codex execpolicy check --pretty --rules .codex/rules/closio-agent.rules -- bash scripts/doctor.sh
prefix_rule(pattern = ["bash", "scripts/configure-user.sh"], decision = "allow", justification = "closio-agent: personal settings (flow-configure-user)")
prefix_rule(pattern = ["bash", "scripts/configure-repo.sh"], decision = "allow", justification = "closio-agent: repo registry (flow-configure-repo)")
prefix_rule(pattern = ["bash", "scripts/setup-repo.sh"], decision = "allow", justification = "closio-agent: repo setup (flow-setup-repo)")
prefix_rule(pattern = ["bash", "scripts/memory.sh"], decision = "allow", justification = "closio-agent: user memory (every flow command)")
prefix_rule(pattern = ["bash", "scripts/doctor.sh"], decision = "allow", justification = "closio-agent: setup checks (flow-doctor)")
prefix_rule(pattern = ["bash", "scripts/vpn.sh"], decision = "allow", justification = "closio-agent: VPN (flow-vpn, flow-connectivity)")
prefix_rule(pattern = ["bash", "scripts/wait-seconds.sh"], decision = "allow", justification = "closio-agent: short wait while Jira loads")
prefix_rule(pattern = ["bash", "scripts/branch-name.sh"], decision = "allow", justification = "closio-agent: branch names (rule A12)")
prefix_rule(pattern = ["bash", "scripts/card-check.sh"], decision = "allow", justification = "closio-agent: card template check (flow-check-card)")
prefix_rule(pattern = ["bash", "scripts/help.sh"], decision = "allow", justification = "closio-agent: command help and the commands-documented check (flow-help, flow-doctor)")
prefix_rule(pattern = ["bash", "scripts/run.sh"], decision = "allow", justification = "closio-agent: the card run folder (flow-status, flow-start and the other card phases)")
prefix_rule(pattern = ["bash", "scripts/card-branch.sh"], decision = "allow", justification = "closio-agent: the card branch in a code repo (flow-start, flow-develop, flow-push)")
prefix_rule(pattern = ["bash", "scripts/repo-run.sh"], decision = "allow", justification = "closio-agent: a repo's own checks, tests, migrations, seeders, servers and Codex's review, on its Node version (flow-develop, flow-verify, flow-ac-check, flow-push, flow-review)")
prefix_rule(pattern = ["bash", "scripts/api-call.sh"], decision = "allow", justification = "closio-agent: one API call to a repo on this Mac, keys added by the script (flow-verify)")
prefix_rule(pattern = ["bash", "scripts/api-check.sh"], decision = "allow", justification = "closio-agent: a card's API test cases (flow-verify, flow-ac-check)")
prefix_rule(pattern = ["bash", "scripts/response-shape.sh"], decision = "allow", justification = "closio-agent: an API's real response against the card's structure (flow-verify; rule A28)")
prefix_rule(pattern = ["bash", "scripts/db-run.sh"], decision = "allow", justification = "closio-agent: a card's test data, only after the user's yes (flow-verify)")
prefix_rule(pattern = ["bash", "scripts/e2e.sh"], decision = "allow", justification = "closio-agent: Playwright setup and a card's web tests (flow-configure-user, flow-verify)")
prefix_rule(pattern = ["bash", "scripts/qmetry-import.sh"], decision = "allow", justification = "closio-agent: a QMetry export into the card's run folder (flow-verify, flow-ac-check)")
prefix_rule(pattern = ["bash", "scripts/ship.sh"], decision = "allow", justification = "closio-agent: a card's commits, its one push with the MR, and review fixes into that MR (flow-push, flow-review)")
prefix_rule(pattern = ["bash", "scripts/gitlab-mr.sh"], decision = "allow", justification = "closio-agent: a card's MR through the GitLab API (description, reviewers, merge state, comments and replies, pipeline), token from the Keychain (flow-push, flow-review, flow-finish)")
