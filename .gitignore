# closio-agent — files that must never be committed (D36)

# Personal, per-user settings and local repo paths (F4/F5): stay on your Mac only
/local/

# Card run folders: committed only to their card's branch runs/<CARD-KEY> by scripts/run.sh, never on main (D61)
/runs/*/

# Secrets must never be committed (D33, D34, A6)
.env
.env.*
*.pem
*.key

# Playwright project dependencies and outputs (D24)
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/
/e2e/.cache/

# Generic
node_modules/
.DS_Store
*.log

# Personal Claude Code settings (each person has their own)
.claude/settings.local.json

# Files Claude Code generates inside a mod folder (types for an editor), e.g. .claude/skills/flow-autocomplete/
.claude/skills/*/.claude-plugin/types/
.claude/skills/*/tsconfig.json

# The chat transcript of building closio-agent: on the builder's Mac only, never pushed (D79)
/build-memory/full-chat-transcript.md

# Python caches from the tests (D92)
__pycache__/
